{
  "name": "tune-arena",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Vadym Tsinderhoz",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:cloudflare",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "deploy": "npm run deploy:cloudflare",
    "deploy:cloudflare": "node scripts/cloudflare.mjs deploy",
    "cloudflare:check": "node scripts/cloudflare-builds.mjs check",
    "cloudflare:repair": "node scripts/cloudflare-builds.mjs repair",
    "setup": "npm --prefix web ci && npm --prefix web run local:setup",
    "dev": "npm --prefix web run dev",
    "test": "node scripts/check.mjs",
    "desktop:install": "npm --prefix desktop ci",
    "desktop": "npm --prefix desktop start",
    "macos": "npm --prefix desktop run build:mac",
    "windows": "npm --prefix desktop run build:win",
    "configure": "node scripts/configure-server.mjs"
  }
}
