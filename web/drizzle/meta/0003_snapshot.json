  "views": {
    "round_outcomes": {
      "columns": {
        "round_id": {
          "name": "round_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "winner_id": {
          "name": "winner_id",
          "type": "text",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        }
      },
      "name": "round_outcomes",
      "isExisting": false,
      "definition": "\n  SELECT r.id AS round_id, (\n    SELECT e.id FROM entries e JOIN votes v ON v.entry_id=e.id\n    WHERE e.round_id=r.id AND e.hidden=0 AND v.created>=r.opens AND v.created<r.closes\n    GROUP BY e.id ORDER BY count(*) DESC,e.created ASC,e.rowid ASC LIMIT 1\n  ) AS winner_id FROM rounds r WHERE r.closes<=unixepoch()\n"
    }
  },
